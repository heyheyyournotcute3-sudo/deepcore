// Deepcore — tech_tree.ron
//
// The team-shared research tree. Each node needs its parents unlocked and a delivery of
// items to the Research Desk. `unlocks` names machines and recipes; machine ids are also
// listed in machines.ron `tech` fields.
[
    // ---------------------------------------------------------------- Era 0
    (id: "hand_tools", name: "Hand Tools", era: 0, parents: [],
     cost: [],
     unlocks: ["craft_workbench", "craft_storage_crate", "craft_ladder", "craft_timber_support", "craft_oil_lamp", "craft_headlamp", "craft_stone_bricks", "craft_concrete", "craft_research_desk"],
     description: "Everything a pickaxe and a workbench can do."),

    // ---------------------------------------------------------------- Era 1
    (id: "smelting", name: "Smelting", era: 1, parents: ["hand_tools"],
     cost: [("clay", 20), ("stone_cobble", 20), ("coal", 10)],
     unlocks: ["brick_kiln", "stone_furnace", "bake_bricks", "bake_fire_brick", "smelt_copper", "smelt_tin", "smelt_iron", "smelt_lead", "smelt_zinc", "smelt_glass", "make_bronze", "make_brass", "craft_brick_kiln", "craft_stone_furnace", "cast_lead_block"],
     description: "Fire clay and rock into a kiln and a furnace."),
    (id: "smithing", name: "Smithing", era: 1, parents: ["smelting"],
     cost: [("iron_ingot", 12), ("copper_ingot", 8)],
     unlocks: ["anvil", "forge_iron_plate", "forge_copper_plate", "forge_lead_plate", "forge_iron_rod", "forge_copper_rod", "forge_iron_gear", "forge_bronze_gear", "draw_copper_pipe", "draw_copper_cable", "refine_zinc_cadmium", "craft_anvil", "craft_steam_canister"],
     description: "An anvil turns ingots into plates, rods and gears."),
    (id: "steelmaking", name: "Steelmaking", era: 1, parents: ["smithing"],
     cost: [("iron_ingot", 20), ("limestone", 10), ("coal", 20)],
     unlocks: ["blast_furnace", "make_steel", "forge_steel_plate", "forge_steel_rod", "forge_steel_gear", "forge_steel_tool_head", "forge_hardened_tool_head", "craft_hardened_steel_pickaxe", "craft_blast_furnace", "craft_steel_support", "cast_steel_block"],
     description: "Iron, coal and flux into steel. Opens the Granite Depths."),

    // ---------------------------------------------------------------- Era 2
    (id: "steam_power", name: "Steam Power", era: 2, parents: ["steelmaking"],
     cost: [("steel_plate", 20), ("copper_pipe", 10), ("bronze_gear", 5)],
     unlocks: ["hand_pump", "steam_boiler", "steam_engine", "craft_hand_pump", "craft_steam_boiler", "craft_steam_engine", "craft_steam_drill", "craft_copper_pipe_block"],
     description: "Water and coal into steam, steam into shaft power."),
    (id: "ore_processing", name: "Ore Processing", era: 2, parents: ["steam_power"],
     cost: [("steel_plate", 16), ("iron_gear", 8)],
     unlocks: ["crusher", "ore_washer", "crush_copper", "crush_tin", "crush_iron", "crush_lead", "crush_zinc", "wash_copper", "wash_tin", "wash_iron", "wash_lead", "wash_zinc", "smelt_crushed_copper", "smelt_crushed_iron", "smelt_crushed_lead", "smelt_crushed_zinc", "smelt_crushed_tin", "smelt_washed_copper", "smelt_washed_iron", "smelt_washed_lead", "smelt_washed_zinc", "smelt_washed_tin", "craft_crusher", "craft_ore_washer"],
     description: "Crushers and washers double your ingots per ore."),
    (id: "logistics", name: "Logistics", era: 2, parents: ["steam_power"],
     cost: [("steel_ingot", 24), ("copper_cable", 12)],
     unlocks: ["mine_lift", "item_pipe", "craft_mine_lift", "craft_item_pipe", "craft_conveyor", "craft_rail"],
     description: "Rails, carts, lifts and pipes: stop hauling by hand."),

    // ---------------------------------------------------------------- Era 3
    (id: "electricity", name: "Electricity", era: 3, parents: ["ore_processing"],
     cost: [("steel_plate", 30), ("copper_cable", 20), ("iron_gear", 10)],
     unlocks: ["steam_turbine", "generator", "battery_bank", "craft_steam_turbine", "craft_generator", "craft_battery_bank", "craft_electric_lamp", "craft_copper_cable_block"],
     description: "Steam into kilowatts, carried on copper cables."),
    (id: "electric_smelting", name: "Electric Smelting", era: 3, parents: ["electricity"],
     cost: [("steel_plate", 24), ("graphite", 12), ("silicon", 6)],
     unlocks: ["arc_furnace", "electrolysis_cell", "electrolyse_aluminium", "electrolyse_salt", "make_sulfuric_acid", "smelt_silicon", "smelt_nickel", "smelt_chromium", "smelt_gold", "cut_obsidian_glass", "forge_aluminium_plate", "craft_arc_furnace", "craft_electrolysis_cell", "press_graphite_block"],
     description: "Arc furnaces and electrolysis: aluminium, silicon, nickel, chromium."),
    (id: "electronics", name: "Electronics", era: 3, parents: ["electric_smelting"],
     cost: [("silicon", 8), ("copper_cable", 16), ("lead_plate", 6)],
     unlocks: ["circuit_assembler", "charging_station", "make_circuit_mk1", "make_motor", "make_battery_pack", "charge_battery_pack", "craft_circuit_assembler", "craft_charging_station", "craft_headlamp_mk2", "make_circuit_mk2"],
     description: "Circuits, motors and battery packs."),
    (id: "mine_safety", name: "Mine Safety", era: 3, parents: ["electronics"],
     cost: [("steel_plate", 20), ("circuit_mk1", 4), ("quartz", 12)],
     unlocks: ["vent_fan", "electric_pump", "ore_scanner", "craft_vent_fan", "craft_electric_pump", "craft_ore_scanner"],
     description: "Vent fans, pumps and the ore scanner."),

    // ---------------------------------------------------------------- Era 4
    (id: "chemistry", name: "Chemistry", era: 4, parents: ["electric_smelting"],
     cost: [("stainless_plate", 12), ("sulfuric_acid", 10), ("fluorite", 8)],
     unlocks: ["chemical_plant", "make_fluorine", "make_sulfuric_acid_bulk", "craft_chemical_plant"],
     description: "Sulfuric acid and fluorine compounds."),
    (id: "advanced_alloys", name: "Advanced Alloys", era: 4, parents: ["chemistry"],
     cost: [("steel_plate", 24), ("nickel_ingot", 8), ("chromium_ingot", 8)],
     unlocks: ["alloy_furnace", "machine_shop", "make_stainless", "make_tungsten_carbide", "forge_stainless_plate", "make_bearing", "make_turbine_blade", "make_drill_head", "forge_tungsten_tool_head", "craft_tungsten_drill", "craft_alloy_furnace", "craft_machine_shop", "smelt_tungsten", "cast_stainless_block"],
     description: "Stainless steel, tungsten carbide and precision parts."),
    (id: "rare_earths", name: "Rare Earths", era: 4, parents: ["advanced_alloys"],
     cost: [("monazite_sand", 12), ("sulfuric_acid", 6), ("stainless_plate", 8)],
     unlocks: ["rare_earth_separator", "separate_rare_earths", "craft_rare_earth_separator"],
     description: "Monazite into rare-earth magnets."),
    (id: "hazard_gear", name: "Hazard Gear", era: 4, parents: ["chemistry"],
     cost: [("lead_plate", 10), ("aluminium_plate", 8), ("circuit_mk1", 2)],
     unlocks: ["decon_shower", "craft_cooling_suit", "craft_respirator", "craft_hazmat_suit", "craft_geiger_counter", "craft_decon_shower"],
     description: "Cooling suits, respirators, hazmat suits and Geiger counters."),

    // ---------------------------------------------------------------- Era 5
    (id: "uranium_milling", name: "Uranium Milling", era: 5, parents: ["chemistry", "hazard_gear"],
     cost: [("stainless_plate", 16), ("sulfuric_acid", 12), ("lead_plate", 10)],
     unlocks: ["leaching_tank", "precipitator", "crush_uranium", "leach_uranium", "precipitate_yellowcake", "craft_leaching_tank", "craft_precipitator"],
     description: "Crush, leach and precipitate uranium into yellowcake."),
    (id: "conversion", name: "Conversion", era: 5, parents: ["uranium_milling"],
     cost: [("yellowcake", 4), ("fluorine_compound", 6), ("stainless_plate", 10)],
     unlocks: ["conversion_plant", "convert_uf6", "craft_conversion_plant"],
     description: "Yellowcake and fluorine into UF6 canisters."),
    (id: "enrichment", name: "Enrichment", era: 5, parents: ["conversion", "rare_earths"],
     cost: [("rare_earth_magnet", 8), ("centrifuge_rotor", 2), ("circuit_mk2", 4)],
     unlocks: ["centrifuge", "enrich_uf6", "craft_centrifuge", "make_centrifuge_rotor"],
     description: "A cascade of centrifuges enriches UF6."),
    (id: "fuel_fabrication", name: "Fuel Fabrication", era: 5, parents: ["enrichment"],
     cost: [("enriched_canister", 2), ("zirconium_tube", 4), ("stainless_plate", 10)],
     unlocks: ["fuel_fabricator", "fabricate_fuel_rod", "fabricate_core_cell", "craft_fuel_fabricator", "make_zirconium_tube"],
     description: "Fuel rods for the reactor and core cells for the drill."),
    (id: "reactor_engineering", name: "Reactor Engineering", era: 5, parents: ["fuel_fabrication"],
     cost: [("stainless_block", 8), ("control_rod", 2), ("circuit_mk2", 4)],
     unlocks: ["reactor_casing", "reactor_core", "reactor_console", "scram_panel", "coolant_pump", "heat_exchanger", "make_control_rod", "craft_reactor_casing", "craft_reactor_core", "craft_reactor_console", "craft_scram_panel", "craft_coolant_pump", "craft_heat_exchanger"],
     description: "Build and control a 5x5x5 reactor."),
    (id: "waste_handling", name: "Waste Handling", era: 5, parents: ["reactor_engineering"],
     cost: [("lead_block", 8), ("concrete", 12), ("depleted_canister", 2)],
     unlocks: ["cooling_pool_block", "waste_vault_block", "cast_shielding_plate", "cool_spent_fuel", "craft_cooling_pool", "craft_waste_vault"],
     description: "Cool spent fuel and vault it safely."),
    (id: "nuclear_drill", name: "Nuclear Drill", era: 5, parents: ["fuel_fabrication"],
     cost: [("drill_head", 1), ("rare_earth_magnet", 4), ("stainless_plate", 8)],
     unlocks: ["nuclear_drill_mount", "craft_nuclear_drill", "craft_nuclear_drill_mount"],
     description: "The end of the ladder: a 3x3 drill that bores to the Mantle Edge."),
]
