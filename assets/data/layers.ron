// Deepcore — layers.ron
//
// Six layers from the surface down. `depth` is (top, bottom) measured in blocks below the
// surface level defined in world.ron (surface_y = 480). Layers must tile the underground
// without gaps or overlaps; the validator checks that.
//
//   base_block    fills most of the layer
//   filler_blocks (block, share) secondary rock mixed in
//   ores          (block, frequency per chunk, vein_size range, optional depth band)
//   hazards       Darkness | Flooding { .. } | Gas { .. } | Heat { .. } | CaveIn { .. } | Radiation { .. }
[
    (id: "topsoil", name: "Topsoil", depth: (16, 0), base_block: "dirt", min_tier: 1, ambient_temp: 14.0, cave_density: 0.6,
     filler_blocks: [("grass", 0.10), ("gravel", 0.06), ("clay", 0.05), ("sand", 0.04)],
     ores: [
        (block: "coal_seam", frequency: 0.55, vein_size: (4, 16)),
        (block: "clay", frequency: 0.30, vein_size: (6, 20)),
        (block: "sand", frequency: 0.20, vein_size: (6, 20)),
     ],
     hazards: []),

    (id: "shale_beds", name: "Shale Beds", depth: (64, 16), base_block: "stone", min_tier: 1, ambient_temp: 18.0, cave_density: 1.0,
     filler_blocks: [("shale", 0.14), ("limestone", 0.10), ("gravel", 0.03)],
     ores: [
        (block: "coal_seam", frequency: 0.60, vein_size: (6, 24)),
        (block: "malachite", frequency: 0.35, vein_size: (5, 14)),
        (block: "cassiterite", frequency: 0.20, vein_size: (4, 10)),
        (block: "hematite", frequency: 0.40, vein_size: (5, 16)),
     ],
     hazards: [Darkness]),

    (id: "granite_depths", name: "Granite Depths", depth: (160, 64), base_block: "granite", min_tier: 2, ambient_temp: 24.0, cave_density: 1.0,
     filler_blocks: [("stone", 0.08), ("limestone", 0.04)],
     ores: [
        (block: "hematite", frequency: 0.35, vein_size: (5, 16)),
        (block: "galena", frequency: 0.22, vein_size: (4, 12)),
        (block: "sphalerite", frequency: 0.22, vein_size: (4, 12)),
        (block: "sulfur_deposit", frequency: 0.18, vein_size: (3, 10)),
        (block: "quartz", frequency: 0.16, vein_size: (3, 9)),
        (block: "bauxite", frequency: 0.18, vein_size: (4, 12)),
        (block: "rock_salt", frequency: 0.26, vein_size: (5, 14)),
        (block: "coal_seam", frequency: 0.20, vein_size: (4, 12)),
     ],
     hazards: [Darkness, Flooding(pocket_chance: 0.06, max_volume: 512)]),

    (id: "basalt_furnace", name: "Basalt Furnace", depth: (288, 160), base_block: "basalt", min_tier: 3, ambient_temp: 38.0, cave_density: 1.1,
     filler_blocks: [("granite", 0.10), ("obsidian", 0.03)],
     ores: [
        (block: "pentlandite", frequency: 0.20, vein_size: (4, 10)),
        (block: "wolframite", frequency: 0.10, vein_size: (3, 7)),
        (block: "chromite", frequency: 0.18, vein_size: (3, 9)),
        (block: "graphite_vein", frequency: 0.20, vein_size: (4, 12)),
        (block: "fluorite", frequency: 0.10, vein_size: (3, 8)),
        (block: "zircon", frequency: 0.08, vein_size: (3, 6)),
        (block: "gold_vein", frequency: 0.07, vein_size: (2, 6)),
        (block: "sulfur_deposit", frequency: 0.12, vein_size: (3, 9)),
        (block: "galena", frequency: 0.10, vein_size: (3, 8)),
     ],
     hazards: [
        Darkness,
        Flooding(pocket_chance: 0.05, max_volume: 512),
        Gas(pocket_chance: 0.05, volume: 40),
        Heat(base: 38.0, per_block: 0.02),
     ]),

    (id: "deep_crust", name: "Deep Crust", depth: (448, 288), base_block: "gneiss", min_tier: 4, ambient_temp: 60.0, cave_density: 0.9,
     filler_blocks: [("obsidian", 0.08), ("basalt", 0.10)],
     ores: [
        (block: "pitchblende", frequency: 0.16, vein_size: (3, 8)),
        (block: "monazite", frequency: 0.10, vein_size: (3, 8)),
        (block: "gold_vein", frequency: 0.06, vein_size: (2, 5)),
        (block: "zircon", frequency: 0.06, vein_size: (2, 5)),
        (block: "wolframite", frequency: 0.07, vein_size: (2, 6)),
     ],
     hazards: [
        Darkness,
        Flooding(pocket_chance: 0.03, max_volume: 512),
        Gas(pocket_chance: 0.04, volume: 50),
        Heat(base: 60.0, per_block: 0.04),
        CaveIn(max_span: 7),
        Radiation(dose_per_sec: 0.02),
