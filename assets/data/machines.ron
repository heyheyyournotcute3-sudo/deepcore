    (id: "scram_panel", name: "Scram Panel", size: (1, 1, 1), energy: None, input_slots: 0, output_slots: 0,
     build_cost: [("stainless_plate", 4), ("circuit_mk2", 2), ("control_rod", 1)], tech: Some("reactor_engineering"), reactor_part: Some("scram"),
     description: "Automatically scrams the reactor above the temperature limit."),
    (id: "coolant_pump", name: "Coolant Pump", size: (1, 1, 1), energy: Electric(kw: 25.0), input_slots: 0, output_slots: 0,
     build_cost: [("stainless_plate", 6), ("motor", 2), ("copper_pipe", 6)], tech: Some("reactor_engineering"), reactor_part: Some("coolant"),
     description: "Feeds coolant through the reactor core."),
    (id: "heat_exchanger", name: "Heat Exchanger", size: (2, 1, 1), energy: None, input_slots: 0, output_slots: 0,
