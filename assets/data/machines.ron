    (id: "reactor_casing", name: "Reactor Casing", size: (1, 1, 1), energy: None, input_slots: 0, output_slots: 0,
     build_cost: [("stainless_block", 4), ("lead_block", 2)], tech: Some("reactor_engineering"), reactor_part: Some("casing"),
     description: "One of the 98 casing blocks of a 5x5x5 reactor shell."),
    (id: "reactor_core", name: "Reactor Core Block", size: (1, 1, 1), energy: None, input_slots: 0, output_slots: 0,
