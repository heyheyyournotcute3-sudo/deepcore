    (id: "ore_scanner", name: "Ore Scanner", size: (1, 1, 1), energy: Electric(kw: 8.0), input_slots: 0, output_slots: 0,
     build_cost: [("steel_plate", 8), ("circuit_mk1", 4), ("quartz", 6)], tech: Some("mine_safety"), description: "Reveals ore within 16 blocks."),

    // ---------------------------------------------------------------- Era 4
    (id: "chemical_plant", name: "Chemical Plant", size: (2, 2, 2), energy: Electric(kw: 60.0), input_slots: 3, output_slots: 3,
