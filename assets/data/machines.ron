// Deepcore — machines.ron
//
// Machine definitions. A machine block in blocks.ron points here with `machine: Some("id")`.
//   size         footprint (x, y, z) in blocks
//   energy       Fuel { slots } | Steam { per_second } | Electric { kw } | Shaft { per_second } | None
//   input_slots  number of input slots in the machine UI
//   output_slots number of output slots
//   build_cost   (item_id, count) paid when the player places the kit
//   tech         tech node that must be unlocked first
//   cascade      Some((min, max)) for centrifuge cascades
//   reactor_part role inside the 5x5x5 reactor ("casing", "moderator", "console", ...)
[
    // ---------------------------------------------------------------- Era 0
    (id: "workbench", name: "Workbench", size: (1, 1, 1), energy: None, input_slots: 0, output_slots: 0,
     build_cost: [("timber", 8)], tech: None, description: "Hand crafting station for Era 0 parts."),
    (id: "storage_crate", name: "Storage Crate", size: (1, 1, 1), energy: None, input_slots: 0, output_slots: 27,
     build_cost: [("timber", 10)], tech: None, description: "27 slots of shared storage."),
    (id: "research_desk", name: "Research Desk", size: (1, 1, 1), energy: None, input_slots: 6, output_slots: 0,
     build_cost: [("timber", 12), ("stone_cobble", 6)], tech: None, description: "Deliver materials to unlock the tech tree."),

    // ---------------------------------------------------------------- Era 1
    (id: "brick_kiln", name: "Brick Kiln", size: (1, 2, 1), energy: Fuel(slots: 1), input_slots: 2, output_slots: 2,
     build_cost: [("clay", 20), ("stone_cobble", 10)], tech: Some("smelting"), description: "Fires clay into bricks and fire bricks."),
    (id: "stone_furnace", name: "Stone Furnace", size: (1, 2, 1), energy: Fuel(slots: 1), input_slots: 2, output_slots: 2,
     build_cost: [("stone_cobble", 24), ("clay", 8)], tech: Some("smelting"), description: "Smelts ore into ingots and makes bronze."),
    (id: "anvil", name: "Anvil", size: (1, 1, 1), energy: None, input_slots: 2, output_slots: 2,
     build_cost: [("iron_ingot", 8)], tech: Some("smithing"), description: "Hammers ingots into plates, rods and gears."),
    (id: "blast_furnace", name: "Blast Furnace", size: (2, 3, 2), energy: Fuel(slots: 1), input_slots: 3, output_slots: 2,
     build_cost: [("fire_brick", 40), ("iron_plate", 12)], tech: Some("steelmaking"), description: "Iron + coal + limestone flux into steel."),

    // ---------------------------------------------------------------- Era 2
    (id: "hand_pump", name: "Hand Pump", size: (1, 1, 1), energy: None, input_slots: 0, output_slots: 0,
     build_cost: [("bronze_ingot", 6), ("copper_pipe", 4)], tech: Some("steam_power"), description: "Supplies water to a boiler."),
    (id: "steam_boiler", name: "Steam Boiler", size: (1, 2, 1), energy: Fuel(slots: 1), input_slots: 1, output_slots: 0,
     build_cost: [("steel_plate", 10), ("copper_pipe", 6), ("bricks", 12)], tech: Some("steam_power"), description: "Burns coal into steam for the pipe network."),
    (id: "steam_engine", name: "Steam Engine", size: (1, 2, 2), energy: Steam(per_second: 4.0), input_slots: 0, output_slots: 0,
     build_cost: [("steel_ingot", 16), ("bronze_gear", 4), ("copper_pipe", 6)], tech: Some("steam_power"), description: "Turns steam into shaft power for nearby machines."),
    (id: "crusher", name: "Crusher", size: (1, 2, 1), energy: Shaft(per_second: 3.0), input_slots: 1, output_slots: 2,
     build_cost: [("steel_ingot", 12), ("iron_gear", 4), ("stone_bricks", 10)], tech: Some("ore_processing"), description: "Crushes ore: 1.5x ingots per ore."),
    (id: "ore_washer", name: "Ore Washer", size: (1, 2, 1), energy: Shaft(per_second: 2.0), input_slots: 2, output_slots: 2,
     build_cost: [("steel_plate", 8), ("copper_pipe", 4), ("bricks", 8)], tech: Some("ore_processing"), description: "Washes crushed ore: 2x ingots per ore."),
    (id: "mine_lift", name: "Mine Lift", size: (1, 2, 1), energy: Shaft(per_second: 2.0), input_slots: 0, output_slots: 0,
     build_cost: [("steel_ingot", 20), ("copper_cable", 8)], tech: Some("logistics"), description: "Carries the player and a cart between levels."),
    (id: "item_pipe", name: "Item Pipe", size: (1, 1, 1), energy: None, input_slots: 0, output_slots: 0,
     build_cost: [("steel_plate", 2)], tech: Some("logistics"), description: "Moves items between adjacent machines."),

    // ---------------------------------------------------------------- Era 3
    (id: "steam_turbine", name: "Steam Turbine", size: (2, 2, 2), energy: Steam(per_second: 10.0), input_slots: 0, output_slots: 0,
