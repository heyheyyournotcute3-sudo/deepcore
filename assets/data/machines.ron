    (id: "precipitator", name: "Precipitator", size: (2, 2, 2), energy: Electric(kw: 35.0), input_slots: 2, output_slots: 2,
     build_cost: [("stainless_plate", 10), ("copper_pipe", 8), ("circuit_mk2", 2)], tech: Some("uranium_milling"), description: "Uranium solution + lye into yellowcake."),
    (id: "conversion_plant", name: "Conversion Plant", size: (2, 2, 2), energy: Electric(kw: 60.0), input_slots: 2, output_slots: 2,
