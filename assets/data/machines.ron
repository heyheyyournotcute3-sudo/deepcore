    (id: "rare_earth_separator", name: "Rare-Earth Separator", size: (2, 2, 2), energy: Electric(kw: 70.0), input_slots: 2, output_slots: 3,
     build_cost: [("stainless_plate", 10), ("circuit_mk2", 4), ("centrifuge_rotor", 2)], tech: Some("rare_earths"), description: "Monazite into rare-earth magnets."),
    (id: "decon_shower", name: "Decon Shower", size: (1, 2, 1), energy: Electric(kw: 10.0), input_slots: 0, output_slots: 0,
     build_cost: [("stainless_plate", 6), ("copper_pipe", 6), ("glass", 4)], tech: Some("hazard_gear"), description: "Clears accumulated radiation dose."),

    // ---------------------------------------------------------------- Era 5: nuclear
    (id: "leaching_tank", name: "Leaching Tank", size: (2, 2, 2), energy: Electric(kw: 40.0), input_slots: 3, output_slots: 2,
