// Deepcore — recipes.ron
//
//   machine  "hand"/"workbench" for manual crafting, otherwise a machine id
//   time     seconds at full speed
//   inputs   (item_id, count)
//   outputs  (item_id, count)
//   tech     tech node required before the recipe can be used
//   power_kw optional override of the machine's draw
//   fuel     items consumed directly by the recipe (kiln/furnace extras)
[
    // ================================================================ Era 0: hand tools
    (id: "craft_workbench", machine: "workbench", time: 2.0, inputs: [("timber", 8)], outputs: [("workbench", 1)]),
