// Deepcore — blocks.ron
//
// Every placeable or breakable block in the world.
//   hardness    seconds to break with a tier-1 tool at speed 1.0
//   min_tier    lowest tool tier that can break it at all (1..5)
//   drops       (item_id, count) — resolved against items.ron
//   color       linear RGB 0..1, the base colour the procedural texture is built from
//   pattern     Flat | Speckle | Blotch | OreFleck((r,g,b)) | Stratified | Glow | Grain
//   radiation   Some((radius_blocks, dose_per_second))
//   machine     Some("machine_id") links a machine block to machines.ron
//
// Ids are grouped: terrain, ores, machine blocks, decorative/functional blocks.
[
    // ---------------------------------------------------------------- terrain
    (id: "air", name: "Air", hardness: 0.0, min_tier: 0, drops: [], color: (0.0, 0.0, 0.0), pattern: Flat, kind: Passable, breakable: false),
    (id: "bedrock", name: "Bedrock", hardness: 999.0, min_tier: 9, drops: [], color: (0.09, 0.09, 0.10), pattern: Blotch, roughness: 1.0, breakable: false),
    (id: "dirt", name: "Dirt", hardness: 0.5, min_tier: 1, drops: [("dirt", 1)], color: (0.30, 0.22, 0.14), pattern: Speckle, layer_hint: Some(1)),
